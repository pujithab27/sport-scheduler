<article class="card"><div class="card-top"><h3><a href="/sessions/<%= item.id %>"><%= item.sport_name %></a></h3><% if (item.cancelled_at) { %><span class="badge cancelled">Cancelled</span><% } else if (item.starts_at <= new Date().toISOString()) { %><span class="badge">Past</span><% } else if (item.joined_count >= item.extra_capacity) { %><span class="badge">Full</span><% } else { %><span class="badge open">Open</span><% } %></div><p><%= new Date(item.starts_at).toLocaleString() %> · <%= item.venue %></p><p>By <%= item.creator_name %> · <%= item.joined_count %>/<%= item.extra_capacity %> additional places filled</p><% if (item.cancelled_at) { %><p><strong>Reason:</strong> <%= item.cancellation_reason %></p><% } %></article>
