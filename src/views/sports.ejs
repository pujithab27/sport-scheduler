<div class="page-heading"><div><p class="eyebrow">Administrator</p><h1>My sports</h1><p class="lede">Add sports that players can select when creating a session.</p></div></div>
<div class="grid"><section class="panel"><h2>Create a sport</h2><% if (error) { %><p class="error" role="alert"><%= error %></p><% } %><form method="post" action="/sports"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Name<input name="name" required maxlength="100"></label><button>Create sport</button></form></section>
<section class="panel"><h2>Sports you created</h2><% if (!sports.length) { %><p>No sports yet.</p><% } else { %><ul class="list"><% sports.forEach(sport => { %><li><strong><%= sport.name %></strong> <a href="/sports/<%= sport.id %>/edit">Edit</a></li><% }) %></ul><% } %></section></div>
