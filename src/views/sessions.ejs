<div class="page-heading"><div><p class="eyebrow">Plan and play</p><h1>Sessions</h1><p class="lede">Find a match to join or organize your next game.</p></div><a class="button" href="/sessions/new">Create session</a></div>
<section><div class="section-heading"><h2>Available to join</h2><span class="count"><%= available.length %></span></div><% if (!available.length) { %><p class="empty">No available sessions right now. Check back later, or create one.</p><% } else { %><div class="cards"><% available.forEach(item => { %><%- include('partials/session-card', {item}) %><% }) %></div><% } %></section>
<section><div class="section-heading"><h2>Created by me</h2><span class="count"><%= created.length %></span></div><% if (!created.length) { %><p class="empty">You have not created a session yet.</p><% } else { %><div class="cards"><% created.forEach(item => { %><%- include('partials/session-card', {item}) %><% }) %></div><% } %></section>
<section><div class="section-heading"><h2>Joined by me</h2><span class="count"><%= joined.length %></span></div><% if (!joined.length) { %><p class="empty">Sessions you join will appear here.</p><% } else { %><div class="cards"><% joined.forEach(item => { %><%- include('partials/session-card', {item}) %><% }) %></div><% } %></section>
