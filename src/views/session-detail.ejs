<p><a href="/sessions">← All sessions</a></p><div class="page-heading"><h1><%= item.sport_name %> session</h1><% if (item.cancelled_at) { %><span class="badge cancelled">Cancelled</span><% } %></div>
<div class="grid"><section class="panel"><h2>Details</h2><dl><dt>When</dt><dd><%= new Date(item.starts_at).toLocaleString() %></dd><dt>Venue</dt><dd><%= item.venue %></dd><dt>Created by</dt><dd><%= item.creator_name %></dd><dt>Additional places</dt><dd><%= item.joined_count %> of <%= item.extra_capacity %> filled</dd></dl>
<% if (item.cancelled_at) { %><p class="error"><strong>Cancellation reason:</strong> <%= item.cancellation_reason %></p><% } %>
<% if (!item.cancelled_at && item.starts_at > new Date().toISOString() && item.creator_id !== user.id && !participants.some(p => p.user_id === user.id) && item.joined_count < item.extra_capacity) { %><h3>Join this session</h3><form method="post" action="/sessions/<%= item.id %>/join"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Choose a team<select name="team" required><option value="1">Team 1</option><option value="2">Team 2</option></select></label><button>Join session</button></form><% } %>
<% if (!item.cancelled_at && item.creator_id === user.id) { %><h3>Cancel this session</h3><form method="post" action="/sessions/<%= item.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Reason<textarea name="reason" required maxlength="500" rows="3"></textarea></label><button class="danger">Cancel session</button></form><% } %></section>
<section class="panel"><h2>Players</h2><% [1,2].forEach(team => { %><h3>Team <%= team %></h3><ul class="list"><% const names = [...initial.filter(p => p.team === team).map(p => p.name), ...participants.filter(p => p.team === team).map(p => p.name)]; if (!names.length) { %><li>No players listed yet.</li><% } else { names.forEach(name => { %><li><%= name %></li><% }) } %></ul><% }) %></section></div>
