<div class="page-heading"><div><p class="eyebrow">Administrator</p><h1>Sessions played</h1><p class="lede">Compare sports over a time period. A played session is past and was not cancelled. Report dates use UTC.</p></div></div><div class="panel"><form method="get" action="/admin/reports" class="inline-form"><label>From<input type="date" name="from" required value="<%= from %>"></label><label>To<input type="date" name="to" required value="<%= to %>"></label><button>Show report</button></form><% if (error) { %><p class="error" role="alert"><%= error %></p><% } %></div>
<% if (report) { %><div class="panel"><h2><%= report.total %> sessions played</h2><div class="table-scroll"><table><thead><tr><th>Sport</th><th>Played sessions</th><th>Share</th></tr></thead><tbody><% report.rows.forEach(row => { %><tr><td><%= row.name %></td><td><%= row.played %></td><td><%= row.percent %>%</td></tr><% }) %></tbody></table></div><% if (!report.rows.length) { %><p>No sports have been created.</p><% } %></div><% } %>
